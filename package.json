{
  "name": "paintwar",
  "private": true,
  "version": "0.1.0",
  "description": "2-4 人实时联机涂地竞技游戏",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephyrwing-ai/paintwar.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm --dir server start",
    "build": "node scripts/manus-game-sharing/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "pnpm --dir server test",
    "smoke": "node scripts/smoke.mjs",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0"
}
